{
  "name": "sealcheck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QoreChain testnet payment-intent binding and hybrid receipt verification",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "check:qore": "node scripts/check-qore.mjs"
  },
  "dependencies": {
    "@qorechain/sdk": "^0.14.0",
    "cosmjs-types": "0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
